#version 450
// RoPE: in-place rotary position embedding.
// x[t][h][i] with i in pairs: rotate (x[i], x[i+1]) by cos/sin((pos+t)*theta)
layout(local_size_x = 64, local_size_y = 1) in;
layout(push_constant) uniform P { uint nt; uint nh; int pos; uint hd; } pc;
layout(set=0,binding=0,std430) buffer X { float x[]; };
void main() {
    uint idx = gl_GlobalInvocationID.x;
    uint total = pc.nt * pc.nh * (pc.hd / 2u);
    if (idx >= total) return;
    uint t = idx / (pc.nh * (pc.hd / 2u));
    uint r = idx % (pc.nh * (pc.hd / 2u));
    uint h = r / (pc.hd / 2u);
    uint pair = r % (pc.hd / 2u);
    uint base = (t * pc.nh + h) * pc.hd + pair * 2u;
    float theta = 1.0 / pow(1000000.0, (2.0 * float(pair)) / float(pc.hd));
    float c = cos(float(pc.pos + int(t)) * theta);
    float s = sin(float(pc.pos + int(t)) * theta);
    float x0 = x[base], x1 = x[base + 1u];
    x[base]     = x0 * c - x1 * s;
    x[base + 1u] = x0 * s + x1 * c;
}
