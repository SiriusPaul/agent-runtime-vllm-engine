#version 450
/* Simple matmul: 1 thread per output, verified on Adreno 650 */
layout(local_size_x = 1, local_size_y = 1) in;
layout(push_constant) uniform P { uint M; uint N; uint K; uint stride; } pc;
layout(set=0,binding=0,std430) readonly buffer W { float w[]; };
layout(set=0,binding=1,std430) readonly buffer X { float x[]; };
layout(set=0,binding=2,std430) writeonly buffer Y { float y[]; };
void main() {
    uint n = gl_WorkGroupID.x; uint m = gl_WorkGroupID.y;
    if (m >= pc.M || n >= pc.N) return;
    float sum = 0.0;
    for (uint k = 0u; k < pc.K; k++) sum += w[n * pc.K + k] * x[m * pc.stride + k];
    y[m * pc.N + n] = sum;
}
