#version 450
// y[i] += x[i]
layout(local_size_x = 64, local_size_y = 1) in;
layout(push_constant) uniform P { uint n; } pc;
layout(set=0,binding=0,std430) buffer Y { float y[]; };
layout(set=0,binding=1,std430) readonly  buffer X { float x[]; };
void main() {
    uint i = gl_GlobalInvocationID.x; if (i >= pc.n) return;
    y[i] += x[i];
}
