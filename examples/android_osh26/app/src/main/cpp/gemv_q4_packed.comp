#version 450

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform P {
    uint M;
    uint N;
    uint K;
    uint stride;
} pc;

layout(set=0,binding=0,std430) readonly buffer W { uint w[]; };
layout(set=0,binding=1,std430) readonly buffer X { float x[]; };
layout(set=0,binding=2,std430) writeonly buffer Y { float y[]; };

shared float partial[256];

void main() {
    const uint n = gl_WorkGroupID.x;
    const uint lid = gl_LocalInvocationID.x;
    if (n >= pc.N) {
        return;
    }

    const uint blocks_per_row = pc.K / 32u;
    const uint row_base = n * blocks_per_row * 9u;
    float sum = 0.0;
    for (uint k = lid; k < pc.K; k += 256u) {
        const uint block = k >> 5u;
        const uint in_block = k & 31u;
        const uint block_base = row_base + block * 9u;
        const float scale = uintBitsToFloat(w[block_base]);
        const uint packed = w[block_base + 1u + (in_block >> 3u)];
        const uint nibble = (packed >> ((in_block & 7u) * 4u)) & 15u;
        const float weight = float(int(nibble) - 8) * scale;
        sum += weight * x[k];
    }
    partial[lid] = sum;

    barrier();
    for (uint offset = 128u; offset > 0u; offset >>= 1u) {
        if (lid < offset) {
            partial[lid] += partial[lid + offset];
        }
        barrier();
    }

    if (lid == 0u) {
        y[n] = partial[0];
    }
}
