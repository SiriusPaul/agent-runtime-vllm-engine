#version 450

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform P {
    uint count;
    uint topk;
    uint base;
    uint out_offset;
} pc;

layout(set = 0, binding = 0, std430) readonly buffer InBuf {
    uint data[];
} uIn;

layout(set = 0, binding = 1, std430) writeonly buffer OutBuf {
    uint data[];
} uOut;

shared float sh_vals[64][32];
shared uint sh_ids[64][32];

void main() {
    const uint lid = gl_LocalInvocationID.x;
    if (lid >= 64u) {
        return;
    }

    float best_val[32];
    uint best_id[32];
    for (uint i = 0u; i < 32u; ++i) {
        best_val[i] = -1e30;
        best_id[i] = 0u;
    }

    for (uint i = lid; i < pc.count; i += 64u) {
        const float v = uintBitsToFloat(uIn.data[i]);
        const uint id = pc.base + i;

        uint min_idx = 0u;
        float min_val = best_val[0];
        for (uint k = 1u; k < 32u; ++k) {
            if (best_val[k] < min_val) {
                min_val = best_val[k];
                min_idx = k;
            }
        }
        if (v > min_val) {
            best_val[min_idx] = v;
            best_id[min_idx] = id;
        }
    }

    for (uint i = 0u; i < 32u; ++i) {
        sh_vals[lid][i] = best_val[i];
        sh_ids[lid][i] = best_id[i];
    }
    barrier();
    memoryBarrierShared();

    if (lid == 0u) {
        float out_val[32];
        uint out_id[32];
        for (uint i = 0u; i < 32u; ++i) {
            out_val[i] = -1e30;
            out_id[i] = 0u;
        }

        for (uint t = 0u; t < 64u; ++t) {
            for (uint i = 0u; i < 32u; ++i) {
                const float v = sh_vals[t][i];
                const uint id = sh_ids[t][i];
                uint min_idx = 0u;
                float min_val = out_val[0];
                for (uint k = 1u; k < 32u; ++k) {
                    if (out_val[k] < min_val) {
                        min_val = out_val[k];
                        min_idx = k;
                    }
                }
                if (v > min_val) {
                    out_val[min_idx] = v;
                    out_id[min_idx] = id;
                }
            }
        }

        for (uint i = 0u; i < pc.topk && i < 32u; ++i) {
            uint max_idx = 0u;
            float max_val = out_val[0];
            for (uint k = 1u; k < 32u; ++k) {
                if (out_val[k] > max_val) {
                    max_val = out_val[k];
                    max_idx = k;
                }
            }
            const uint out_idx = (pc.out_offset + i) * 2u;
            uOut.data[out_idx + 0u] = out_id[max_idx];
            uOut.data[out_idx + 1u] = floatBitsToUint(max_val);
            out_val[max_idx] = -1e30;
        }
    }
}
